# UniBook Environment Configuration Example
DEBUG=True
SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production

ALLOWED_HOSTS=localhost,127.0.0.1,unibook.campus.edu

# Database Configuration (MySQL 8+ Recommended for Production)
# To use MySQL: set DB_ENGINE=mysql and provide the database credentials below.
DB_ENGINE=mysql
DB_NAME=unibook_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Razorpay Payment Gateway (Optional Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

